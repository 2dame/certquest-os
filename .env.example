# =============================================================================
# CertQuest OS — environment variables
# Copy this file to `.env` (root), `apps/web/.env.local`, and
# `apps/mobile/.env` as appropriate. Anything prefixed EXPO_PUBLIC_ is exposed
# to the mobile bundle; anything prefixed NEXT_PUBLIC_ is exposed to the web
# bundle. Service-role keys must remain server-side only.
# =============================================================================

# ---- Supabase (web — Next.js) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Supabase (mobile — Expo) ----
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Supabase (server-only — content seeding, migrations) ----
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# ---- Expo / push notifications ----
EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
