{
  "expo": {
    "name": "CertQuest OS",
    "slug": "certquest-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "certquest",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.certquest.os"
    },
    "android": {
      "package": "com.certquest.os",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B10"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#E5C97B"
        }
      ]
    ],
    "extra": {
      "router": { "origin": false }
    }
  }
}
